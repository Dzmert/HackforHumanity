# Dev image for a Base44 app: Node (frontend/Vite) + Deno (local Base44 backend) + Base44 CLI.
# The app source is bind-mounted at runtime; dependencies are installed at startup.
FROM node:22-bookworm

# Deno runtime — the local Base44 backend (`base44 dev`) runs on it.
RUN apt-get update && apt-get install -y --no-install-recommends curl unzip ca-certificates \
    && curl -fsSL https://deno.land/install.sh | sh \
    && ln -s /root/.deno/bin/deno /usr/local/bin/deno \
    && apt-get clean && rm -rf /var/lib/apt/lists/*

# Base44 CLI — authenticates non-interactively via BASE44_API_KEY (workspace key).
RUN npm install -g base44@latest

WORKDIR /app
EXPOSE 5173
