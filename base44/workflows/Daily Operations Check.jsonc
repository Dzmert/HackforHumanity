          "then": "end",
          "x-base44": {
            "title": "Check operations",
            "description": "Review grants and stock"
          }
        }
      }
    ]
  },
  "name": "Daily Operations Check",
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "0 8 * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "description": "Checks grant deadlines and supply levels each morning"
}