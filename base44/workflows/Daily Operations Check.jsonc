{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "daily_operations_check",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "check_operations": {
          "call": "invoke_backend_function",
