{
  "name": "VolunteerEvent",
  "type": "object",
  "description": "Append-only log of volunteer roster activity, used for scheduling information only. Volunteers can add their own events but cannot read them back.",
  "properties": {
    "volunteer_id": {
      "type": "string"
    },
    "volunteer_name": {
      "type": "string"
    },
    "event_type": {
      "type": "string",
      "enum": [
        "claimed",
        "completed",
        "dropped",
        "no_show"
      ]
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "shift_id": {
      "type": "string"
    },
    "shift_title": {
      "type": "string"
    },
    "note": {
      "type": "string"
    }
  },
  "required": [
    "volunteer_id",
    "event_type",
    "occurred_at"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "caseworker"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "data.volunteer_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "caseworker"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "caseworker"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}