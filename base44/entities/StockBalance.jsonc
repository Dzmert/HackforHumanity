{
  "name": "StockBalance",
  "type": "object",
  "description": "Rebuildable, non-authoritative stock snapshot. On-hand equals balance plus movements newer than last_movement_timestamp_included.",
  "properties": {
    "supply_item": {
      "type": "string",
      "description": "SupplyItem record ID."
    },
    "storage_location": {
      "type": "string",
      "description": "StorageLocation record ID."
    },
    "balance": {
      "type": "number",
      "readOnly": true
    },
    "last_movement_timestamp_included": {
      "type": "string",
      "format": "date-time",
      "readOnly": true
    }
  },
  "required": [
    "supply_item",
    "storage_location",
    "balance",
    "last_movement_timestamp_included"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "volunteer"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "stock_balance_service_only"
      }
    },
    "update": {
      "user_condition": {
        "role": "stock_balance_service_only"
      }
    },
    "delete": {
      "user_condition": {
        "role": "stock_balance_service_only"
      }
    }
  }
}