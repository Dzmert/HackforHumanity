{
  "name": "SpecialisationChecklistItem",
  "type": "object",
  "description": "Specialist-authored checklist of elements that should be covered for a client carrying a given specialisation tag. Authored by specialists via an admin; the code-level provisional list is only a stand-in until they do.",
  "properties": {
    "specialisation": {
      "type": "string",
      "enum": [
        "Domestic & Family Violence",
        "Housing",
        "Always Mum"
      ]
    },
    "item_key": {
      "type": "string",
      "description": "Stable identifier for this checklist element."
    },
    "item_label": {
      "type": "string"
    },
    "satisfied_by_fields": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "CaseNote field names that, once all stated on the client's complete notes, mean this element has been covered."
    },
    "sort_order": {
      "type": "number",
      "default": 0
    },
    "is_active": {
      "type": "boolean",
      "default": true
    }
  },
  "required": [
    "specialisation",
    "item_key",
    "item_label"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "caseworker"
          }
        },
        {
          "user_condition": {
            "role": "project_services_manager"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}