{
  "name": "SupplyItemBarcode",
  "type": "object",
  "properties": {
    "supply_item": {
      "type": "string",
      "description": "SupplyItem record ID."
    },
    "barcode": {
      "type": "string",
      "unique": true
    }
  },
  "required": [
    "supply_item",
    "barcode"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "volunteer"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}