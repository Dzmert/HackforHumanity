{
  "name": "SupportingDocument",
  "type": "object",
  "description": "One supporting document a support letter may need. Default sets are PROVISIONAL \u2014 drawn from what DCJ Housing and refuge services commonly ask for, to be confirmed by Lou's Place. Caseworkers add and remove items freely.",
  "properties": {
    "support_letter_id": {
      "type": "string"
    },
    "client_reference": {
      "type": "string"
    },
    "item_label": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "Have",
        "Requested",
        "Not applicable",
        "Not yet asked"
      ],
      "default": "Not yet asked"
    },
    "is_provisional_default": {
      "type": "boolean",
      "default": true,
      "description": "True for items seeded from the provisional default set, false for items a caseworker added."
    },
    "notes": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "support_letter_id",
    "item_label"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "caseworker"
          }
        },
        {
          "user_condition": {
            "role": "project_services_manager"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "caseworker"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "caseworker"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "caseworker"
          }
        }
      ]
    }
  }
}